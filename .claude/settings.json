{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv sync)",
      "Bash(uv add *)",
      "Bash(uv run *)",
      "Bash(uv init *)",
      "Bash(uv python *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright screenshot *)",
      "Bash(npx playwright install chromium)",
      "Bash(node *)",
      "Bash(cd frontend && *)",
      "Bash(bash scripts/demo.sh *)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -sN http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sN http://localhost:*)",
      "Bash(lsof -i *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sqlite3 *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push origin main*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(npm publish *)",
      "Bash(rm -rf *)"
    ]
  }
}
